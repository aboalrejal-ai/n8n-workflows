    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Tool Name: customerAccountSalesforceByCountry\nDescription: \"Searches the Salesforce database for records matching a specific country. Use this tool to find a customers and account details.  Requires query (string) as input. Returns a list of matching customers  and account details including Name, ID, Email, Address, and Country\"\n\nAcceptable Query Values:\n\n-United States of America\n-Mexico",
        "resource": "search",
        "query": "=SELECT Id, Name, BillingCountry, \n                   (SELECT Id, FirstName, LastName, Email FROM Contacts)\n            FROM Account\n            WHERE BillingCountry='{{$fromAI(\"Query\", \"\", \"string\")}}'"
      },
      "type": "n8n-nodes-base.salesforceTool",
      "typeVersion": 1,
      "position": [
        -64,
