          "name": "Salesforce account"
        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Tool Name: leadsByCustomerandCountry\nDescription: \"Searches the Salesforce database for records matching a specific country. Use this tool to find a customers and account details.  Requires query (string) as input. Returns a list of matching customers  and account details including Name, ID, Email, Address, and Country\"\n\nAcceptable Query Values:\n\n- Country\n- CustomerNaame",
        "resource": "search",
        "query": "=SELECT Id, Name, Company, Country, Email \n    FROM Lead \n    WHERE Country = 'United States of America' \n    AND Company = '{{ $fromAI(\"Query\",\"\", \"string\") }}'"
