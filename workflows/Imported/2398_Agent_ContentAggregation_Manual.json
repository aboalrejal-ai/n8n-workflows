          "name": "Ollama account"
        }
      },
      "name": "Ollama Chat Model",
      "parameters": {
        "model": "gpt-oss:120b-cloud",
        "options": {
          "format": "json",
          "temperature": 0.7
        }
      },
      "position": [
        -608,
